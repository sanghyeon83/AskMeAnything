{
    "manifest_version": 3,
    "name": "Ctrl+휠 페이지 확대/축소",
    "version": "1.0",
    "description": "윈도우처럼 Ctrl+마우스휠로 페이지 콘텐츠를 확대/축소합니다",
    "permissions": ["tabs"],
    "background": { "service_worker": "bg.js" },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ]
}
